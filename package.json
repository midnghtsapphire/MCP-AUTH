import { createConnection } from 'typeorm';
import { User } from './entities/User';
export async function connectDatabase() {
  await createConnection({
    type: 'postgres',
    host: 'localhost',
    port: 5432,
    username: 'postgres',
    password: 'password',
    database: 'mcp_auth',
    entities: [User],
    synchronize: true,
    logging: false,
  });
}
