import { Entity, PrimaryGeneratedColumn, Column } from 'typeorm';
import { Length } from 'class-validator';
@Entity()
export class User {
  @PrimaryGeneratedColumn()
  id: number;
  @Column()
  @Length(4, 100)
  username: string;
  @Column()
  @Length(4, 100)
  password: string;
}
